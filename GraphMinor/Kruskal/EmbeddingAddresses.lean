module

public import GraphMinor.Kruskal.RootAddressEmbedding

/-!
# Address maps for recursive tree embeddings

The root case of the recursive embedding relation matches source branches
injectively to target branches. The descending case chooses a single target
branch. We carry those choices through the relation's nested recursor,
constructing injective address maps that preserve last common ancestors.
-/

@[expose] public section

namespace GraphMinor.Kruskal.OrderedTree

/-- An injective matching of branch indices with an address embedding in
every matched pair of branches. -/
structure BranchAddressEmbedding (ts us : List OrderedTree) where
  indices : Fin ts.length ↪ Fin us.length
  branches : ∀ i, AddressEmbedding ts[i] us[indices i]

namespace BranchAddressEmbedding

/-- The empty list of branches embeds in every target list. -/
def nil (us : List OrderedTree) : BranchAddressEmbedding [] us where
  indices := ⟨Fin.elim0, fun i ↦ Fin.elim0 i⟩
  branches := fun i ↦ Fin.elim0 i

/-- Match the first branches and then the two remaining branch lists. -/
def cons {s t : OrderedTree} {ts us : List OrderedTree}
    (φ : AddressEmbedding s t) (ψ : BranchAddressEmbedding ts us) :
    BranchAddressEmbedding (s :: ts) (t :: us) where
  indices := {
    toFun := Fin.cases 0 (fun i ↦ (ψ.indices i).succ)
    inj' := by
      intro i j hij
      cases i using Fin.cases with
      | zero =>
        cases j using Fin.cases with
        | zero => rfl
        | succ j =>
          have h : 0 = (ψ.indices j).val + 1 := congrArg Fin.val hij
          omega
      | succ i =>
        cases j using Fin.cases with
        | zero =>
          have h : (ψ.indices i).val + 1 = 0 := congrArg Fin.val hij
          omega
        | succ j =>
          have h : (ψ.indices i).val + 1 = (ψ.indices j).val + 1 := congrArg Fin.val hij
          exact congrArg Fin.succ (ψ.indices.injective (Fin.ext (Nat.add_right_cancel h))) }
  branches := Fin.cases φ (fun i ↦ ψ.branches i)

/-- Skip the first target branch. -/
def skip {t : OrderedTree} {ts us : List OrderedTree} (ψ : BranchAddressEmbedding ts us) :
    BranchAddressEmbedding ts (t :: us) where
  indices := ψ.indices.trans ⟨Fin.succ, Fin.succ_injective _⟩
  branches := fun i ↦ ψ.branches i

end BranchAddressEmbedding

/-- Every embedding generated by root matching and descent gives an
injective vertex map preserving last common ancestors. -/
theorem Embeds.exists_addressEmbedding {s t : OrderedTree} (h : Embeds s t) :
    Nonempty (AddressEmbedding s t) := by
  refine Embeds.rec
    (motive_1 := fun s t _ ↦ Nonempty (AddressEmbedding s t))
    (motive_2 := fun ts us _ ↦ Nonempty (BranchAddressEmbedding ts us))
    (root := ?_) (dive := ?_) (nil := ?_) (cons := ?_) (cons_right := ?_) h
  · intro ts us hsub ih
    obtain ⟨ψ⟩ := ih
    exact ⟨AddressEmbedding.root ψ.indices ψ.branches⟩
  · intro s t ts ht hsub ih
    obtain ⟨φ⟩ := ih
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.1 ht
    exact ⟨AddressEmbedding.dive ⟨i, hi⟩ φ⟩
  · intro us
    exact ⟨BranchAddressEmbedding.nil us⟩
  · intro s t ts us hst hsub ihst ihsub
    obtain ⟨φ⟩ := ihst
    obtain ⟨ψ⟩ := ihsub
    exact ⟨BranchAddressEmbedding.cons φ ψ⟩
  · intro t ts us hsub ih
    obtain ⟨ψ⟩ := ih
    exact ⟨BranchAddressEmbedding.skip ψ⟩

end GraphMinor.Kruskal.OrderedTree
