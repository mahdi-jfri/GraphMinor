module
public import GraphMinor.Thomason.UniformCell
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# The integer test for a cell of the interval certificate

A cell of the interval certificate of Section 5 of the note
`docs/thomason/uniform_minor_bound.tex` is given by natural numbers: the right end
`b = bn / bd` of the `x` interval, the block size `k`, the penalty
`P = pn / pd` and the bound `π = qn / qd` on the non-neighbour proportion.
The interval data are `L`, `U`, the square-root bounds `sL = sLn / sLd`,
`sU = sUn / sUd` and `ρ = rn / rd`. The test `cellOK` clears all
denominators of the hypotheses of `cell_bound`, so it uses only arithmetic
on natural numbers. The data are generated by
`docs/thomason/medium_log2_certificate.py`, whose exact checker
performs the same tests.
-/

public section
namespace GraphMinor.Thomason.Uniform

/-- One cell: right end `bn / bd`, block size `k`, penalty `pn / pd` and
non-neighbour proportion `qn / qd`. -/
structure Cell where
  bn : ℕ
  bd : ℕ
  k : ℕ
  pn : ℕ
  pd : ℕ
  qn : ℕ
  qd : ℕ

/-- One interval `L ≤ p ≤ U` of the certificate with its cells. -/
structure Interval where
  L : ℕ
  U : ℕ
  aL : ℕ
  aU : ℕ
  sLn : ℕ
  sLd : ℕ
  sUn : ℕ
  sUd : ℕ
  rn : ℕ
  rd : ℕ
  cells : List Cell

/-- The integer test for a cell whose left end is `an / ad`. -/
@[expose] def cellOK (I : Interval) (an ad : ℕ) (c : Cell) : Bool :=
  let X := 67 * I.L * I.sLn * an
  let Y := 25 * I.sLd * ad
  let Z := 67 * I.U * I.sUn * c.bn
  let V := 25 * I.sUd * c.bd
  let Fn := (2 ^ (c.k - 1) - 1) * (c.qn * X) ^ (c.k - 1)
  let Fd := (c.qd * (X - (c.k - 1) * Y)) ^ (c.k - 1)
  let Hn := (c.k + 1) ^ (c.k + 1) * Z * X ^ c.k * c.qn ^ (c.k * c.k)
  let Hd := c.k ^ (c.k + 1) * (2 * V) * (X - c.k * Y) ^ c.k * c.qd ^ (c.k * c.k)
  let g1 := 67 * I.sLn * an
  let g2 := 25 * I.sLd * ad * c.k
  let e1 := Fd * c.pd - Fn * c.pd - c.pn * Fd
  let e2 := Fd * c.pd
  decide (1 ≤ c.k) && decide (0 < an) && decide (0 < ad) && decide (0 < c.bd) &&
  decide (an * c.bd < c.bn * ad) && decide (c.bn ≤ c.bd) &&
  decide (0 < c.pn) && decide (0 < c.pd) && decide (0 < c.qd) &&
  decide (c.bn * c.qd * I.rd ≤ 2 * c.qn * c.bn * I.rd + I.rn * c.bd * c.qd) &&
  decide (c.k * Y < X) &&
  decide (Hn * c.pd ^ (c.k + 1) ≤ c.pn ^ (c.k + 1) * Hd) &&
  decide (Fn * c.pd + c.pn * Fd < Fd * c.pd) &&
  decide ((I.U - 3) * g2 * I.L * e2 < I.U * (g1 * I.L - g2) * e1)

/-- The consecutive cells, starting at `an / ad` and ending at `1`. -/
@[expose] def cellsOK (I : Interval) : ℕ → ℕ → List Cell → Bool
  | an, ad, [] => an == ad
  | an, ad, c :: cs => cellOK I an ad c && cellsOK I c.bn c.bd cs

/-- The integer test for an interval. -/
@[expose] def intervalOK (I : Interval) : Bool :=
  decide (110 ≤ I.L) && decide (I.L ≤ I.U) &&
  decide (2 ^ I.aL ≤ I.L ^ 1000) && decide (I.U ^ 1000 ≤ 2 ^ I.aU) &&
  decide (0 < I.sLn) && decide (0 < I.sLd) && decide (0 < I.sUd) &&
  decide (I.sLn ^ 2 * 1000 ≤ I.aL * I.sLd ^ 2) && decide (I.aU * I.sUd ^ 2 ≤ I.sUn ^ 2 * 1000) &&
  decide (0 < I.rn) && decide (I.rn < I.rd) &&
  decide (67 * (I.rn * 4489 * I.L * I.sLn + 3975 * I.sLd * I.rd) ≤ 25 * I.rd * 4489 * I.L * I.sLn) &&
  cellsOK I I.rn I.rd I.cells

/-- An accepted cell gives the hypotheses of `cell_bound`, hence its
conclusion. -/
theorem cell_bound_of_cellOK {I : Interval} {an ad : ℕ} {c : Cell}
    (hc : cellOK I an ad c = true) (p n q : ℕ) (hL : 1 ≤ I.L) (hpL : I.L ≤ p)
    (hpU : p ≤ I.U)
    (hnlo : (an : ℝ) / ad * (67 / 25) * p * ((I.sLn : ℝ) / I.sLd) ≤ n)
    (hnhi : (n : ℝ) ≤ 67 / 25 * I.U * ((I.sUn : ℝ) / I.sUd) * ((c.bn : ℝ) / c.bd))
    (hq : (q : ℝ) ≤ (c.qn : ℝ) / c.qd * n) (hsL : 0 < I.sLn) (hsLd : 0 < I.sLd)
    (hsUd : 0 < I.sUd) (hU3 : 3 ≤ I.U) :
    ((p : ℝ) - 2) - 1 < ((n / c.k : ℕ) : ℝ) * (1 - ((2 : ℝ) ^ (c.k - 1) - 1) *
        ((q : ℝ) / ((n : ℝ) - c.k + 1)) ^ (c.k - 1) -
        1 / (((c.k : ℝ) + 1) / (c.k * ((c.pn : ℝ) / c.pd)))) -
      ((n / c.k : ℕ) : ℝ) * (((n / c.k : ℕ) : ℝ) - 1) / 2 *
        (((c.k : ℝ) + 1) / (c.k * ((c.pn : ℝ) / c.pd)) * (n * ((q : ℝ) / n) ^ c.k) /
          ((n : ℝ) - c.k)) ^ c.k := by
  simp only [cellOK, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hk, han⟩, had⟩, hbd⟩, hab⟩, hb1⟩, hpn⟩, hpd⟩, hqd⟩, hπb⟩, hkX⟩, hH⟩,
    hFP⟩, htest⟩ := hc
  set k := c.k
  obtain ⟨X, hXdef⟩ : ∃ X, X = 67 * I.L * I.sLn * an := ⟨_, rfl⟩
  obtain ⟨Y, hYdef⟩ : ∃ Y, Y = 25 * I.sLd * ad := ⟨_, rfl⟩
  obtain ⟨Z, hZdef⟩ : ∃ Z, Z = 67 * I.U * I.sUn * c.bn := ⟨_, rfl⟩
  obtain ⟨V, hVdef⟩ : ∃ V, V = 25 * I.sUd * c.bd := ⟨_, rfl⟩
  rw [← hXdef, ← hYdef] at hkX
  rw [← hXdef, ← hYdef, ← hZdef, ← hVdef] at hH
  rw [← hXdef, ← hYdef] at hFP htest
  have hY : 0 < Y := by rw [hYdef]; positivity
  have hX : 0 < X := lt_of_le_of_lt (Nat.zero_le _) hkX
  have hXk1 : (k - 1) * Y < X := lt_of_le_of_lt (Nat.mul_le_mul_right _ (Nat.sub_le _ _)) hkX
  have hYR : (0 : ℝ) < Y := by exact_mod_cast hY
  have hadR : (0 : ℝ) < ad := by exact_mod_cast had
  have hsLdR : (0 : ℝ) < I.sLd := by exact_mod_cast hsLd
  have hnlo_eq : (67 / 25 : ℝ) * I.L * ((I.sLn : ℝ) / I.sLd) * ((an : ℝ) / ad) = X / Y := by
    rw [hXdef, hYdef]; push_cast; field_simp
  have hkR : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hXkY : ((X - k * Y : ℕ) : ℝ) = X - k * Y := by
    rw [Nat.cast_sub hkX.le]; push_cast; ring
  have hXk1Y : ((X - (k - 1) * Y : ℕ) : ℝ) = X - k * Y + Y := by
    rw [Nat.cast_sub hXk1.le]; push_cast [Nat.cast_sub hk]; ring
  have hXkYpos : (0 : ℝ) < X - k * Y := by
    have : ((k * Y : ℕ) : ℝ) < X := by exact_mod_cast hkX
    push_cast at this; linarith
  set Fn := (2 ^ (k - 1) - 1) * (c.qn * X) ^ (k - 1)
  set Fd := (c.qd * (X - (k - 1) * Y)) ^ (k - 1)
  have hFd : 0 < Fd := pow_pos (Nat.mul_pos hqd (by omega)) _
  have hFdR : (0 : ℝ) < Fd := by exact_mod_cast hFd
  have hpdR : (0 : ℝ) < c.pd := by exact_mod_cast hpd
  have hqdR : (0 : ℝ) < c.qd := by exact_mod_cast hqd
  refine cell_bound p n q k I.L I.U ((I.sLn : ℝ) / I.sLd) ((I.sUn : ℝ) / I.sUd)
    ((an : ℝ) / ad) ((c.bn : ℝ) / c.bd) ((c.qn : ℝ) / c.qd) ((c.pn : ℝ) / c.pd)
    ((Fn : ℝ) / Fd) hk hL hpL hpU (by positivity) (by positivity) hnlo hnhi hq
    (by positivity) (by positivity) ?_ ?_ ?_ ?_ ?_
  · -- `k < n₋`
    rw [hnlo_eq, lt_div_iff₀ hYR]
    exact_mod_cast hkX
  · -- the connectivity loss is the fraction `Fn / Fd`
    rw [hnlo_eq]
    apply le_of_eq
    have h2 : ((2 ^ (k - 1) - 1 : ℕ) : ℝ) = (2 : ℝ) ^ (k - 1) - 1 := by
      rw [Nat.cast_sub Nat.one_le_two_pow]; push_cast; ring
    have hne : (X : ℝ) - k * Y + Y ≠ 0 := by linarith
    have hbase : (c.qn : ℝ) / c.qd * ((X : ℝ) / Y) / ((X : ℝ) / Y - k + 1) =
        ((c.qn * X : ℕ) : ℝ) / ((c.qd * (X - (k - 1) * Y) : ℕ) : ℝ) := by
      rw [Nat.cast_mul, Nat.cast_mul, hXk1Y]
      field_simp
    rw [hbase, div_pow, ← h2, ← mul_div_assoc]
    simp only [Fn, Fd]
    rw [← Nat.cast_pow, ← Nat.cast_pow, ← Nat.cast_mul]
  · -- the penalty bound
    have hVR : (0 : ℝ) < V := by
      have : 0 < V := by rw [hVdef]; positivity
      exact_mod_cast this
    have hnhi_eq : (67 / 25 : ℝ) * I.U * ((I.sUn : ℝ) / I.sUd) * ((c.bn : ℝ) / c.bd) = Z / V := by
      have : (0 : ℝ) < I.sUd := by exact_mod_cast hsUd
      have : (0 : ℝ) < c.bd := by exact_mod_cast hbd
      rw [hZdef, hVdef]; push_cast; field_simp
    rw [hnlo_eq, hnhi_eq]
    have hH' : (((k + 1) ^ (k + 1) * Z * X ^ k * c.qn ^ (k * k) : ℕ) : ℝ) * (c.pd : ℝ) ^ (k + 1) ≤
        (c.pn : ℝ) ^ (k + 1) * ((k ^ (k + 1) * (2 * V) * (X - k * Y) ^ k * c.qd ^ (k * k) : ℕ) : ℝ) := by
      exact_mod_cast hH
    have hk0 : (0 : ℝ) < k := by linarith
    have hHd : (0 : ℝ) < ((k ^ (k + 1) * (2 * V) * (X - k * Y) ^ k * c.qd ^ (k * k) : ℕ) : ℝ) := by
      rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_mul, Nat.cast_pow, Nat.cast_pow, Nat.cast_pow, hXkY]
      push_cast
      positivity
    calc (((k : ℝ) + 1) / k) ^ (k + 1) * ((Z : ℝ) / V / 2) * ((X : ℝ) / Y / ((X : ℝ) / Y - k)) ^ k *
          ((c.qn : ℝ) / c.qd) ^ (k * k)
        = (((k + 1) ^ (k + 1) * Z * X ^ k * c.qn ^ (k * k) : ℕ) : ℝ) /
            ((k ^ (k + 1) * (2 * V) * (X - k * Y) ^ k * c.qd ^ (k * k) : ℕ) : ℝ) := by
          rw [Nat.cast_mul (k ^ (k + 1) * (2 * V) * (X - k * Y) ^ k), Nat.cast_mul (k ^ (k + 1) * (2 * V)),
            Nat.cast_pow (X - k * Y), hXkY]
          have hne : (X : ℝ) - k * Y ≠ 0 := hXkYpos.ne'
          have hden : (X : ℝ) / Y - k = (X - k * Y) / Y := by field_simp
          rw [hden]
          push_cast
          simp only [div_pow]
          field_simp
      _ ≤ ((c.pn : ℝ) / c.pd) ^ (k + 1) := by
          rw [div_pow, div_le_div_iff₀ hHd (by positivity)]
          linarith
  · -- `F + P < 1`
    have h : ((Fn * c.pd + c.pn * Fd : ℕ) : ℝ) < ((Fd * c.pd : ℕ) : ℝ) := by exact_mod_cast hFP
    push_cast at h
    rw [div_add_div _ _ hFdR.ne' hpdR.ne', div_lt_one (by positivity)]
    linarith
  · -- the final test
    have hG : Y * k < 67 * I.sLn * an * I.L := by
      by_contra h
      have h0 : 67 * I.sLn * an * I.L - Y * k = 0 := by omega
      rw [h0] at htest
      simp at htest
    have hUR : (3 : ℝ) ≤ I.U := by exact_mod_cast hU3
    have hLR : (1 : ℝ) ≤ I.L := by exact_mod_cast hL
    have hkpos : (0 : ℝ) < k := by linarith
    have hht : ((I.U - 3 : ℕ) : ℝ) * ((Y : ℝ) * k) * I.L * ((Fd : ℝ) * c.pd) <
        (I.U : ℝ) * (((67 * I.sLn * an * I.L - Y * k : ℕ)) : ℝ) *
          (((Fd * c.pd - Fn * c.pd - c.pn * Fd : ℕ)) : ℝ) := by
      exact_mod_cast htest
    have hs1 : Fn * c.pd ≤ Fd * c.pd := le_of_lt (lt_of_le_of_lt (Nat.le_add_right _ _) hFP)
    have hs2 : c.pn * Fd ≤ Fd * c.pd - Fn * c.pd :=
      Nat.le_sub_of_add_le (by rw [add_comm]; exact hFP.le)
    rw [Nat.cast_sub hU3, Nat.cast_sub hG.le, Nat.cast_sub hs2, Nat.cast_sub hs1] at hht
    push_cast at hht
    have hsLdR' : (0 : ℝ) < I.sLd := hsLdR
    have hlhs : (67 / 25 * ((I.sLn : ℝ) / I.sLd) * ((an : ℝ) / ad) / k - 1 / I.L) *
        (1 - (Fn : ℝ) / Fd - (c.pn : ℝ) / c.pd) =
        ((67 * I.sLn * an * I.L : ℝ) - Y * k) * ((Fd : ℝ) * c.pd - Fn * c.pd - c.pn * Fd) /
          ((Y : ℝ) * k * I.L * (Fd * c.pd)) := by
      rw [hYdef]; push_cast
      field_simp
    rw [hlhs, lt_div_iff₀ (by positivity)]
    have hUpos : (0 : ℝ) < I.U := by linarith
    have r1 : ((I.U : ℝ) - 3) * ((Y : ℝ) * k) * I.L * ((Fd : ℝ) * c.pd) =
        ((I.U : ℝ) - 3) * ((Y : ℝ) * k * I.L * (Fd * c.pd)) := by ring
    have r2 : (I.U : ℝ) * ((67 * I.sLn * an * I.L : ℝ) - Y * k) *
        ((Fd : ℝ) * c.pd - Fn * c.pd - c.pn * Fd) = (I.U : ℝ) * (((67 * I.sLn * an * I.L : ℝ) -
          Y * k) * ((Fd : ℝ) * c.pd - Fn * c.pd - c.pn * Fd)) := by ring
    rw [r1, r2] at hht
    generalize (Y : ℝ) * k * I.L * (Fd * c.pd) = Q at hht ⊢
    generalize ((67 * I.sLn * an * I.L : ℝ) - Y * k) * ((Fd : ℝ) * c.pd - Fn * c.pd - c.pn * Fd) = E
      at hht ⊢
    refine lt_of_mul_lt_mul_right ?_ hUpos.le
    have e1 : (1 - 3 / (I.U : ℝ)) * Q * I.U = (I.U - 3) * Q := by field_simp
    rw [e1]
    linarith

end GraphMinor.Thomason.Uniform
