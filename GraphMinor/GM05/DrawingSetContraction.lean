module

public import GraphMinor.Surface.TopologyStatements
import GraphMinor.GM05.DrawingEdgeContraction
import GraphMinor.GM19.Section6Minor
import GraphMinor.GM19.Section6a

/-!
# Contracting any finite set of drawing edges

For GM V, (8.14), repeat the one-edge contraction, including loop
deletion. Keep a map of the original vertices and a bijection of the
uncontracted edges. Two vertices have the same image exactly when the
contracted edges join them. No forest or loop-free condition is needed.
-/

public section
namespace GraphMinor.GM05
open Set Topology Surface GM19

/-- The finite contraction step in the drawing argument of GM V,
proof of (8.14), page 113. The equivalence relation is generated by
pairs of ends of the edges to be contracted. -/
theorem exists_drawing_contract_set {S : Type} [TopologicalSpace S]
    (hS : IsClosedSurface S) (D : Surface.Drawing S) {C : Set (Set S)} (hC : C⊆D.E) :
    ∃ (H : Surface.Drawing S) (π : S → S) (ε : Set S → Set S),H.V=π '' D.V ∧
      (∀ x∈D.V,∀ y∈D.V,π x=π y ↔
        Relation.EqvGen (fun p q ↦ ∃ e∈C,p∈tilde e ∧ q∈tilde e) x y) ∧
      BijOn ε (D.E\C) H.E ∧ (∀ e∈D.E\C,tilde (ε e)=π '' tilde e) := by
  classical
  let : T2Space S := hS.2.1
  have hV : ∀ e∈D.E,tilde e⊆D.V := fun e he x hx ↦ by
    rw [tilde_eq_inter_V D he] at hx
    exact hx.2
  have key : ∀ C₀ : Set (Set S),C₀.Finite → C₀⊆D.E →
      ∃ (H : Surface.Drawing S) (π : S → S) (ε : Set S → Set S),H.V=π '' D.V ∧
        (∀ x∈D.V,∀ y∈D.V,π x=π y ↔ Conn C₀ x y) ∧
        BijOn ε (D.E\C₀) H.E ∧ (∀ e∈D.E\C₀,tilde (ε e)=π '' tilde e) := by
    intro C₀ hfin
    induction C₀,hfin using Set.Finite.induction_on with
    | empty =>
      intro _
      refine ⟨D,id,id,(image_id _).symm,?_,?_,?_⟩
      · intro x _ y _
        exact ⟨fun h ↦ by change x=y at h; subst h; exact .refl _,
          fun h ↦ Conn.map_eq id (fun e he ↦ (notMem_empty e he).elim) h⟩
      · rw [sdiff_empty]
        exact bijOn_id _
      · intro e _
        exact (image_id _).symm
    | @insert f C₀ hfC₀ hfin ih =>
      intro hsub
      have hfD : f∈D.E := hsub (mem_insert _ _)
      have hC₀ : C₀⊆D.E := (subset_insert _ _).trans hsub
      obtain ⟨H,π,ε,hHV,hπ,hε,hεt⟩ := ih hC₀
      have hfE : f∈D.E\C₀ := ⟨hfD,hfC₀⟩
      have hf' : ε f∈H.E := hε.mapsTo hfE
      obtain ⟨H',φ,-,-,hV',hφ,hb,ht⟩ := exists_drawing_contract_edge hS H hf'
      refine ⟨H',φ∘π,image φ∘ε,by rw [hV',hHV,image_comp],?_,?_,?_⟩
      · intro x hx y hy
        have hπV : ∀ x∈D.V,π x∈H.V := fun x hx ↦ hHV ▸ mem_image_of_mem _ hx
        have htf := hεt f hfE
        rw [Function.comp_apply,Function.comp_apply,hφ _ (hπV x hx) _ (hπV y hy)]
        constructor
        · rintro (h|⟨h1,h2⟩)
          · exact ((hπ x hx y hy).mp h).of_subset (subset_insert _ _)
          · rw [htf] at h1 h2
            obtain ⟨z,hz,hzx⟩ := h1
            obtain ⟨z',hz',hzy⟩ := h2
            have c1 := ((hπ z (hV f hfD hz) x hx).mp hzx).of_subset (subset_insert f C₀)
            have c2 := ((hπ z' (hV f hfD hz') y hy).mp hzy).of_subset (subset_insert f C₀)
            have c3 : Conn (insert f C₀) z z' := .rel _ _ ⟨f,mem_insert _ _,hz,hz'⟩
            exact .trans _ _ _ (.symm _ _ c1) (.trans _ _ _ c3 c2)
        · intro h
          have h1 : (φ∘π) x=(φ∘π) y := by
            refine Conn.map_eq (φ∘π) ?_ h
            intro e he a ha b hb'
            rcases he with rfl|he
            · have ha' : π a∈tilde (ε e) := by rw [htf]; exact mem_image_of_mem _ ha
              have hb'' : π b∈tilde (ε e) := by rw [htf]; exact mem_image_of_mem _ hb'
              exact (hφ _ (hπV a (hV e hfD ha)) _ (hπV b (hV e hfD hb'))).mpr (.inr ⟨ha',hb''⟩)
            · have heD := hC₀ he
              have heq : π a=π b := (hπ a (hV e heD ha) b (hV e heD hb')).mpr (.rel _ _ ⟨e,he,ha,hb'⟩)
              rw [Function.comp_apply,Function.comp_apply,heq]
          exact (hφ _ (hπV x hx) _ (hπV y hy)).mp h1
      · have hsd : D.E\insert f C₀=(D.E\C₀)\{f} := by
          ext e
          simp only [mem_sdiff,mem_insert_iff,mem_singleton_iff,not_or]
          tauto
        rw [hsd]
        have h1 : BijOn ε ((D.E\C₀)\{f}) (H.E\{ε f}) := by
          refine ⟨fun e he ↦ ⟨hε.mapsTo he.1,fun h ↦ he.2 (hε.injOn he.1 hfE h)⟩,
            hε.injOn.mono sdiff_subset,?_⟩
          intro y hy
          obtain ⟨e,he,rfl⟩ := hε.surjOn hy.1
          exact ⟨e,⟨he,fun h ↦ hy.2 (h ▸ rfl)⟩,rfl⟩
        exact hb.comp h1
      · intro e he
        have he' : e∈D.E\C₀ := ⟨he.1,fun h ↦ he.2 (mem_insert_of_mem _ h)⟩
        have hne : e≠f := fun h ↦ he.2 (h ▸ mem_insert _ _)
        have hne' : ε e≠ε f := fun h ↦ hne (hε.injOn he' hfE h)
        rw [Function.comp_apply,ht _ (hε.mapsTo he') hne',hεt e he',image_comp]
  exact key C (D.finite_edges.subset hC) hC

end GraphMinor.GM05
